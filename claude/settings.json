{
  "model": "opus",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "Read(//~/Documents/AIBrain/**)",
      "Write(//~/Documents/AIBrain/**)",
      "Edit(//~/Documents/AIBrain/**)"
    ],
    "additionalDirectories": [
      "~/Documents/AIBrain"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/Documents/AIBrain/.claude/hooks/auto-commit.sh"
          }
        ]
      }
    ]
  }
}
